<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Task 8d: the top-bar sync status reads the current connectivity. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- networkSecurityConfig applies on API 24+; below that the in-code
        ApiClient policy (HTTPS except loopback/private hosts) still applies. -->
    <application
        android:name=".CaregiverApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:ignore="UnusedAttribute"
        android:theme="@style/Theme.Caregiver.Startup">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
