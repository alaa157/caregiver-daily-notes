# Local-run environment template for caregiver-daily-notes.
# Copy to `.env` (gitignored, never commit it) and fill in real values.
# Canonical names must match GitHub Actions Secrets exactly.
# Real values live in: GitHub repo Secrets, Supabase Dashboard (Database),
# Upstash Console. Nothing real is stored in this file, ever.

# --- Supabase PostgreSQL (pooler preferred on free tier) ---
# From: Supabase Dashboard → Project Settings → Database → Connection string (URI).
DATABASE_URL=postgresql://postgres:CHANGEME@db.CHANGEME.supabase.co:6543/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=CHANGEME

# --- Upstash Redis (TLS) ---
# From: Upstash Console → Redis database → REST/TCP credentials.
REDIS_URL=rediss://default:CHANGEME@CHANGEME.upstash.io:6379

# --- Auth ---
# Generate locally: openssl rand -base64 32. Never reuse across environments.
JWT_SECRET=CHANGEME

# --- AI (optional for local runs; app falls back to "AI unavailable") ---
# From: Hugging Face → Settings → Access Tokens. Tests use fakes, never this.
HF_API_KEY=

# --- Local run (once the application entrypoint exists, see Member 3 #12) ---
#   source .env   # or: set -a; source .env; set +a
#   mvn -f backend/pom.xml spring-boot:run
# Share with phone/other machines:
#   cloudflared tunnel --url http://localhost:8080
